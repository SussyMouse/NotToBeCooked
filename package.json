{
  "name": "NotToBeCooked",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo --filter web dev",
    "dev:desktop": "pnpm --filter desktop tauri dev",
    "dev:android": "pnpm --filter desktop tauri android dev",
    "dev:concept": "pnpm --filter concept dev",
    "dev:api": "turbo --filter api dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "verify": "turbo typecheck lint build",
    "schema:update": "cd apps/api && uv run python scripts/generate_openapi.py && pnpm --filter @workspace/contracts generate",
    "codegen": "pnpm schema:update"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "~6"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
