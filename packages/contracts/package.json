{
  "name": "@workspace/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.ts && openapi-zod-client ./openapi.json -o ./src/zod.ts",
    "build": "pnpm run generate"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.0",
    "openapi-zod-client": "^1.18.3",
    "typescript": "~6.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./zod": "./src/zod.ts"
  },
  "dependencies": {
    "@zodios/core": "^10.9.6",
    "zod": "^4.4.3"
  }
}
